// How Oatmeal is signed. Out of the box it's ad-hoc ("Sign to Run Locally"), so anyone can build it.
//
// Ad-hoc signatures change with every build, so macOS asks for the microphone, calendar and
// Accessibility again after each rebuild. To keep those grants, sign with your own certificate:
// copy Signing.local.example.xcconfig to Signing.local.xcconfig and fill it in (git ignores it).
OATMEAL_SIGN_IDENTITY = -
OATMEAL_TEAM =

#include? "Signing.local.xcconfig"
